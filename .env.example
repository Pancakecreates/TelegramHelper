# Токен control-бота (получить у @BotFather)
BOT_TOKEN=

# Telegram user_id владельцев (узнать у @userinfobot). Несколько ID через запятую.
OWNER_TELEGRAM_IDS=

# Алиасы аккаунтов (имя: ID аккаунта)
# Пример: ACCOUNT_ALIASES={"Имя1": "123456789", "Имя2": "987654321", "Имя3": "555666777"}
ACCOUNT_ALIASES=

# Ключ шифрования для сессий и API-токенов (Fernet, base64).
# Сгенерировать: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# Путь к БД (по умолчанию data/app.db)
DATABASE_URL=sqlite+aiosqlite:///data/app.db
